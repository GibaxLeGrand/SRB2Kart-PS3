+/* 2026-09-02 -- etat texenv.
+ *
+ * glTexEnv* etait un corps vide dans toutes ses variantes, donc GL_MODULATE et
+ * GL_REPLACE se comportaient pareil (en pratique REPLACE, le shader "minimal"
+ * ne lisant jamais la couleur de sommet). On stocke le mode par unite ; c'est
+ * psgl_ffp_state_mask() qui le traduit en cle de programme.
+ *
+ * Non suivi : GL_TEXTURE_ENV_COLOR (le mode GL_BLEND l'approxime avec du blanc,
+ * comme IoQuake3-PS3) et les combineurs GL_COMBINE. Un pname inconnu est ignore
+ * en silence, comme le fait deja psgl_context_tex_parameter.
+ */
+void psgl_context_tex_env(GLenum target, GLenum pname, GLint param)
+{
+    PSGLcontext *context = g_psgl.current_context;
+    uint32_t unit;
+
+    if (!context) return;
+    if (target != GL_TEXTURE_ENV) return;
+    if (pname != GL_TEXTURE_ENV_MODE) return;
+
+    unit = psgl_texture_unit_index(context->active_texture);
+    if (unit >= PSGL_MAX_TEXTURE_UNITS) return;
+
+    if (context->textures[unit].env_mode == (GLenum)param) return;
+    context->textures[unit].env_mode = (GLenum)param;
+
+    /* Le choix du programme depend de cet etat : forcer sa reevaluation. */
+    context->dirty |= PSGL_DIRTY_CG;
+}

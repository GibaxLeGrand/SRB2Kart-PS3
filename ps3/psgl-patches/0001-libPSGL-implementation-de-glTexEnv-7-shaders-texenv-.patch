@@ -392,14 +392,18 @@ GLAPI void glTexParameterf(GLenum target, GLenum pname, GLfloat param)
 GLAPI void glTexParameterx(GLenum target, GLenum pname, GLfixed param)
 { psgl_context_tex_parameter(target, pname, (GLint)(param / 65536)); }
 
+/* 2026-09-02 -- les variantes flottantes/fixes passent par le meme etat que
+   glTexEnvi. GL_TEXTURE_ENV_MODE est un enum : le convertir en entier est la
+   traduction attendue. GL_TEXTURE_ENV_COLOR n'est pas suivi (voir
+   psgl_context_tex_env). */
 GLAPI void glTexEnvf(GLenum target, GLenum pname, GLfloat param)
-{ (void)target; (void)pname; (void)param; }
+{ psgl_context_tex_env(target, pname, (GLint)param); }
 GLAPI void glTexEnvfv(GLenum target, GLenum pname, const GLfloat *params)
-{ (void)target; (void)pname; (void)params; }
+{ if (params) psgl_context_tex_env(target, pname, (GLint)params[0]); }
 GLAPI void glTexEnvx(GLenum target, GLenum pname, GLfixed param)
-{ (void)target; (void)pname; (void)param; }
+{ psgl_context_tex_env(target, pname, (GLint)(param / 65536)); }
 GLAPI void glTexEnvxv(GLenum target, GLenum pname, const GLfixed *params)
-{ (void)target; (void)pname; (void)params; }
+{ if (params) psgl_context_tex_env(target, pname, (GLint)(params[0] / 65536)); }
 
 GLAPI void glClientActiveTexture(GLenum texture)
 { psgl_context_client_active_texture(texture); }

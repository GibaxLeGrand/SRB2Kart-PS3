diff --git a/sdk/libPSGL/shaders/ffp_texenv_add.cg b/sdk/libPSGL/shaders/ffp_texenv_add.cg
new file mode 100644
index 0000000..1d782ca
--- /dev/null
+++ b/sdk/libPSGL/shaders/ffp_texenv_add.cg
@@ -0,0 +1,8 @@
+void main(
+    float4 color : COLOR0,
+    float2 tc0   : TEXCOORD0,
+    uniform sampler2D tex0 : TEXUNIT0,
+    out float4 out_color : COLOR)
+{
+    out_color = tex2D(tex0, tc0) + color;
+}
diff --git a/sdk/libPSGL/shaders/ffp_texenv_blend.cg b/sdk/libPSGL/shaders/ffp_texenv_blend.cg
new file mode 100644
index 0000000..d324cb1
--- /dev/null
+++ b/sdk/libPSGL/shaders/ffp_texenv_blend.cg
@@ -0,0 +1,10 @@
+void main(
+    float4 color : COLOR0,
+    float2 tc0   : TEXCOORD0,
+    uniform sampler2D tex0 : TEXUNIT0,
+    out float4 out_color : COLOR)
+{
+    float4 texel = tex2D(tex0, tc0);
+    out_color.rgb = color.rgb * (1.0f - texel.rgb) + texel.rgb;
+    out_color.a   = color.a * texel.a;
+}
diff --git a/sdk/libPSGL/shaders/ffp_texenv_decal.cg b/sdk/libPSGL/shaders/ffp_texenv_decal.cg
new file mode 100644
index 0000000..822b9e4
--- /dev/null
+++ b/sdk/libPSGL/shaders/ffp_texenv_decal.cg
@@ -0,0 +1,10 @@
+void main(
+    float4 color : COLOR0,
+    float2 tc0   : TEXCOORD0,
+    uniform sampler2D tex0 : TEXUNIT0,
+    out float4 out_color : COLOR)
+{
+    float4 texel = tex2D(tex0, tc0);
+    out_color.rgb = lerp(color.rgb, texel.rgb, texel.a);
+    out_color.a   = color.a;
+}

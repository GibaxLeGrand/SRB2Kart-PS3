 GLAPI void glTexEnvi(GLenum target, GLenum pname, GLint param)
-{ (void)target; (void)pname; (void)param; }
+{ psgl_context_tex_env(target, pname, param); }
 GLAPI void glTexEnviv(GLenum target, GLenum pname, const GLint *params)
